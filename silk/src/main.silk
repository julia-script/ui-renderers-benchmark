//! Raw ui-tree benchmark on the shared simulated chat session (500 messages + scroll + stream).
//! Uses a custom ambient `Tracer` to capture exact nanosecond phase timings inside UiTree:
//!   - setup (font collection, fonts, images, stylesheet parse)
//!   - tree build (500 messages via raw ui-tree mutations)
//!   - style resolution (ui_tree.resolveStyles)
//!   - text analysis & shaping (ui_tree.text.analyze + ui_tree.text.shape)
//!   - pure layout (ui_tree.layout minus text analysis & shaping)
//!   - render prep / paint (ui_tree.paintRoots + ui_tree.scene.finish)
//!   - glyph atlas raster & uploads (ui_tree.gatherUploads)
import ui_tree.lib { Tree, BoxNode, TextNode, Resource, Viewport, TreeError, ProtocolError, Attribute }
import ui_tree.mutation { FIRST_ROOT, Mutation }
import ui_tree.style_runtime
import font_collection.lib { FontCollection }
import silk.build.source { Source }
import silk.collections.list { List }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.sync { Arc }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.string { String, InvalidUtf8 }
import silk.trace { Tracer, SpanKind, Place, SpanContext }

const WIDTH: f32 = 1040.0
const HEIGHT: f32 = 720.0
const SCALE: f32 = 1.0
const INITIAL_MESSAGES: usize = 500
const SCROLL_FRAMES: usize = 30
const STREAM_FRAMES: usize = 30

// ---------- Nanosecond monotonic clock & custom Tracer ----------

effect fn nowNs() -> u64 {
  let mut clock = OsMonotonicClock.make()
  let t = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  let s = i64.toU64(t.seconds())
  let ns = u32.toU64(t.subsecondNanoseconds())
  return s * 1000000000 + ns
}

const B_NONE: usize = 0
const B_APPLY: usize = 1
const B_STYLE: usize = 2
const B_LAYOUT: usize = 3
const B_ANALYZE: usize = 4
const B_SHAPE: usize = 5
const B_PAINT: usize = 6
const B_PAINT_ROOTS: usize = 7
const B_SCENE_FINISH: usize = 8
const B_UPLOADS: usize = 9
const BUCKET_COUNT: usize = 10

struct ProfState {
  stackBucket: [usize; 64],
  stackStart: [u64; 64],
  depth: usize,
  ns: [u64; 10],
  calls: [u64; 10],
}

impl ProfState {
  fn make() -> ProfState {
    return ProfState {
      stackBucket: [0; 64],
      stackStart: [0; 64],
      depth: 0,
      ns: [0; 10],
      calls: [0; 10],
    }
  }

  fn reset(self: &mut Self) -> () {
    let mut i: usize = 0
    while i < BUCKET_COUNT {
      self.ns[i] = 0
      self.calls[i] = 0
      i = i + 1
    }
    self.depth = 0
  }
}

fn bucketOf(static name: string<'static>) -> usize {
  if name == "ui_tree.apply" { return B_APPLY }
  if name == "ui_tree.resolveStyles" { return B_STYLE }
  if name == "ui_tree.layout" { return B_LAYOUT }
  if name == "ui_tree.text.analyze" { return B_ANALYZE }
  if name == "ui_tree.text.shape" { return B_SHAPE }
  if name == "ui_tree.paint" { return B_PAINT }
  if name == "ui_tree.paintRoots" { return B_PAINT_ROOTS }
  if name == "ui_tree.scene.finish" { return B_SCENE_FINISH }
  if name == "ui_tree.gatherUploads" { return B_UPLOADS }
  return B_NONE
}

struct BenchTracer {
  state: *mut ProfState,
}

impl Transferable for BenchTracer {}
impl Concurrent for BenchTracer {}

impl Tracer for BenchTracer {
  effect fn enter<Args>(
    self: &Self,
    static name: string<'static>,
    static kind: SpanKind,
    static place: Place,
    args: &Args,
    remote: Option<SpanContext>,
  ) -> () {
    drop kind
    drop place
    drop args
    drop remote
    let b = bucketOf(name)
    let mut token = ()
    let s = unsafe Pointer.borrowMut(&mut token, self.state)
    if s.depth < 64 {
      s.stackBucket[s.depth] = b
      if b != B_NONE {
        s.stackStart[s.depth] = run nowNs()
      } else {
        s.stackStart[s.depth] = 0
      }
      s.depth = s.depth + 1
    }
  }

  effect fn exit(self: &Self) -> () {
    let mut token = ()
    let s = unsafe Pointer.borrowMut(&mut token, self.state)
    if s.depth > 0 {
      s.depth = s.depth - 1
      let b = s.stackBucket[s.depth]
      if b != B_NONE {
        let now = run nowNs()
        let elapsed = now - s.stackStart[s.depth]
        s.ns[b] = s.ns[b] + elapsed
        s.calls[b] = s.calls[b] + 1
      }
    }
  }

  effect fn failed(self: &Self, static error: string<'static>) -> () { drop error }
  effect fn cancelled(self: &Self) -> () {}
  effect fn attribute<V>(self: &Self, static key: string<'static>, value: &V) -> () {
    drop key
    drop value
  }
  effect fn event<Args>(self: &Self, static name: string<'static>, args: &Args) -> () {
    drop name
    drop args
  }
  effect fn recordError<V>(self: &Self, value: &V) -> () { drop value }
  effect fn link(self: &Self, context: &SpanContext) -> () { drop context }
}

// ---------- Helpers for parsing data/chat.txt ----------

fn utf8(bytes: &[u8]) -> string {
  return String.fromUtf8(bytes) |> Result<string, InvalidUtf8>.unwrapOr("")
}

fn findByte(bytes: &[u8], start: usize, end: usize, target: u8) -> usize {
  let mut i = start
  while i < end {
    if bytes[i] == target { return i }
    i = i + 1
  }
  return end
}

fn sliceStr(src: string, start: usize, end: usize) -> string {
  if end <= start { return "" }
  return String.slice(src, start, end - start)
}

effect fn makeBox(tree: &mut Tree<'_>, className: string) -> BoxNode ! TreeError | OutOfMemoryError ? &mut Allocator {
  let b = run tree.box(&[])
  run tree.setAttribute(b, Attribute.ClassName { value: run String.copy(className) })
  return b
}

effect fn makeTextBox(tree: &mut Tree<'_>, className: string, content: string) -> BoxNode ! TreeError | OutOfMemoryError ? &mut Allocator {
  let b = run makeBox(&mut tree, className)
  let t = run tree.text(content)
  run tree.append(b, t)
  return b
}

effect fn appendSpans(tree: &mut Tree<'_>, parent: BoxNode, src: string, bytes: &[u8], start: usize, end: usize) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut pos = start
  while pos < end {
    let sep = findByte(bytes, pos, end, 9) // '\t'
    if sep > pos + 2 && bytes[pos + 1] == 58 { // ':'
      let kind = bytes[pos]
      let text = sliceStr(src, pos + 2, sep)
      if kind == 78 { // 'N'
        let t = run tree.text(text)
        run tree.append(parent, t)
      } else {
        let cls = if kind == 66 { "b" } else if kind == 73 { "i" } else if kind == 67 { "ic" } else { "lnk" }
        let sp = run tree.span(&[])
        run tree.setAttribute(sp, Attribute.ClassName { value: run String.copy(cls) })
        let t = run tree.text(text)
        run tree.append(sp, t)
        run tree.append(parent, sp)
      }
    }
    pos = if sep < end { sep + 1 } else { end }
  }
}

struct MessageSlices {
  source: string<'static>,
  starts: List<usize>,
}

struct SliceRange {
  start: usize,
  end: usize,
}

impl MessageSlices {
  effect fn parse() -> MessageSlices ! OutOfMemoryError ? &mut Allocator {
    let source = String.fromUtf8(Source.read("data/chat.txt")) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
    let bytes = String.utf8Bytes(source)
    let mut starts = List<usize>.make()
    let mut at: usize = 0
    while at < bytes.length {
      if at + 1 < bytes.length && bytes[at] == 77 && bytes[at + 1] == 124 { // "M|"
        run starts.append(at)
      }
      while at < bytes.length && bytes[at] != 10 { at = at + 1 }
      at = at + 1
    }
    return MessageSlices { source: source, starts: move starts }
  }

  fn rangeOf(self: &Self, index: usize) -> SliceRange {
    let s = self.starts.asSlice()
    let a = s[index]
    let b = if index + 1 < s.length { s[index + 1] } else { String.byteLength(self.source) }
    return SliceRange { start: a, end: b }
  }
}

effect fn appendMessage(
  tree: &mut Tree<'_>,
  scroller: BoxNode,
  corpus: &MessageSlices,
  index: usize,
  pics: &[Resource; 4],
) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let rng = corpus.rangeOf(index)
  let start = rng.start
  let end = rng.end
  let src = corpus.source
  let bytes = String.utf8Bytes(src)

  // Parse header line: M|id|mine|author|initials|time|tags
  let eol0 = findByte(bytes, start, end, 10)
  let p1 = findByte(bytes, start + 2, eol0, 124) // after id
  let p2 = findByte(bytes, p1 + 1, eol0, 124) // after mine
  let p3 = findByte(bytes, p2 + 1, eol0, 124) // after author
  let p4 = findByte(bytes, p3 + 1, eol0, 124) // after initials
  let p5 = findByte(bytes, p4 + 1, eol0, 124) // after time

  let mine = (p1 + 1 < p2) && (bytes[p1 + 1] == 49) // '1'
  let author = sliceStr(src, p2 + 1, p3)
  let initials = sliceStr(src, p3 + 1, p4)
  let time = sliceStr(src, p4 + 1, p5)

  let card = run makeBox(&mut tree, if mine { "msg mine" } else { "msg" })
  let head = run makeBox(&mut tree, "msg-head")
  let av = run makeTextBox(&mut tree, "avatar", initials)
  let meta = run makeBox(&mut tree, "meta")
  let authBox = run makeTextBox(&mut tree, "author", author)
  let timeBox = run makeTextBox(&mut tree, "time", time)
  run tree.append(meta, authBox)
  run tree.append(meta, timeBox)
  let tagsBox = run makeBox(&mut tree, "tags")
  let mut tp = p5 + 1
  while tp < eol0 {
    let comma = findByte(bytes, tp, eol0, 44) // ','
    if comma > tp {
      let tag = run makeTextBox(&mut tree, "tag", sliceStr(src, tp, comma))
      run tree.append(tagsBox, tag)
    }
    tp = if comma < eol0 { comma + 1 } else { eol0 }
  }
  run tree.append(head, av)
  run tree.append(head, meta)
  run tree.append(head, tagsBox)
  run tree.append(card, head)

  let mut curUl = Option<BoxNode>.None
  let mut curTbl = Option<BoxNode>.None
  let mut tblRow: usize = 0

  let mut pos = if eol0 < end { eol0 + 1 } else { end }
  while pos < end {
    let eol = findByte(bytes, pos, end, 10)
    if eol > pos + 1 {
      let b0 = bytes[pos]
      let b1 = bytes[pos + 1]
      if b0 != 76 { curUl = Option<BoxNode>.None } // not 'L'
      if b0 != 84 {
        curTbl = Option<BoxNode>.None
        tblRow = 0
      } // not 'T'

      if b0 == 80 && b1 == 124 { // P|
        let p = run makeBox(&mut tree, "p")
        run appendSpans(&mut tree, p, src, bytes, pos + 2, eol)
        run tree.append(card, p)
      } else if b0 == 72 && b1 == 124 { // H|
        let h = run makeTextBox(&mut tree, "h", sliceStr(src, pos + 2, eol))
        run tree.append(card, h)
      } else if b0 == 81 && b1 == 124 { // Q|
        let q = run makeBox(&mut tree, "q")
        run appendSpans(&mut tree, q, src, bytes, pos + 2, eol)
        run tree.append(card, q)
      } else if b0 == 76 && b1 == 124 { // L|
        let ul = match curUl {
          Option<BoxNode>.Some { value } => value
          Option<BoxNode>.None => {
            let u = run makeBox(&mut tree, "ul")
            run tree.append(card, u)
            curUl = Option<BoxNode>.Some { value: u }
            u
          }
        }
        let li = run makeBox(&mut tree, "li")
        let dot = run makeBox(&mut tree, "dot")
        let lt = run makeBox(&mut tree, "lt")
        run appendSpans(&mut tree, lt, src, bytes, pos + 2, eol)
        run tree.append(li, dot)
        run tree.append(li, lt)
        run tree.append(ul, li)
      } else if b0 == 67 && b1 == 124 { // C|
        let pre = run makeBox(&mut tree, "pre")
        let mut cp = pos + 2
        while cp < eol {
          let sep = findByte(bytes, cp, eol, 9)
          let cl = run makeTextBox(&mut tree, "cl", sliceStr(src, cp, sep))
          run tree.append(pre, cl)
          cp = if sep < eol { sep + 1 } else { eol }
        }
        run tree.append(card, pre)
      } else if b0 == 84 && b1 == 72 && pos + 2 < eol && bytes[pos + 2] == 124 { // TH|
        let tbl = run makeBox(&mut tree, "tbl")
        run tree.append(card, tbl)
        curTbl = Option<BoxNode>.Some { value: tbl }
        tblRow = 0
        let mut cp = pos + 3
        while cp < eol {
          let sep = findByte(bytes, cp, eol, 9)
          let th = run makeTextBox(&mut tree, "th", sliceStr(src, cp, sep))
          run tree.append(tbl, th)
          cp = if sep < eol { sep + 1 } else { eol }
        }
      } else if b0 == 84 && b1 == 82 && pos + 2 < eol && bytes[pos + 2] == 124 { // TR|
        if let Option<BoxNode>.Some { value: tbl } = curTbl {
          let cls = if (tblRow % 2) == 1 { "td odd" } else { "td" }
          let mut cp = pos + 3
          while cp < eol {
            let sep = findByte(bytes, cp, eol, 9)
            let td = run makeTextBox(&mut tree, cls, sliceStr(src, cp, sep))
            run tree.append(tbl, td)
            cp = if sep < eol { sep + 1 } else { eol }
          }
          tblRow = tblRow + 1
        }
      } else if b0 == 73 && b1 == 124 { // I|pic|w|h|caption
        let q1 = findByte(bytes, pos + 2, eol, 124)
        let q2 = findByte(bytes, q1 + 1, eol, 124)
        let q3 = findByte(bytes, q2 + 1, eol, 124)
        let picIdx: usize = if pos + 2 < q1 { u8.toUsize(bytes[pos + 2] - 48) % 4 } else { 0 }
        let fig = run makeBox(&mut tree, "fig")
        let im = run tree.image(pics[picIdx], &[])
        run tree.setAttribute(im, Attribute.ClassName { value: run String.copy("pic") })
        let cap = run makeTextBox(&mut tree, "cap", sliceStr(src, q3 + 1, eol))
        run tree.append(fig, im)
        run tree.append(fig, cap)
        run tree.append(card, fig)
      }
    }
    pos = if eol < end { eol + 1 } else { end }
  }

  if !mine {
    let foot = run makeBox(&mut tree, "foot")
    let a1 = run makeTextBox(&mut tree, "act", "Copy")
    let a2 = run makeTextBox(&mut tree, "act", "Retry")
    let a3 = run makeTextBox(&mut tree, "act", "Cite")
    run tree.append(foot, a1)
    run tree.append(foot, a2)
    run tree.append(foot, a3)
    run tree.append(card, foot)
  }

  run tree.append(scroller, card)
}

struct StreamCard {
  card: BoxNode,
  foot: BoxNode,
  textNode: TextNode,
}

effect fn makeStreamCard(tree: &mut Tree<'_>, scroller: BoxNode) -> StreamCard ! TreeError | OutOfMemoryError ? &mut Allocator {
  let card = run makeBox(&mut tree, "msg")
  let head = run makeBox(&mut tree, "msg-head")
  let av = run makeTextBox(&mut tree, "avatar", "A")
  let meta = run makeBox(&mut tree, "meta")
  let auth = run makeTextBox(&mut tree, "author", "Assistant")
  let tm = run makeTextBox(&mut tree, "time", "21:00")
  run tree.append(meta, auth)
  run tree.append(meta, tm)
  let tags = run makeBox(&mut tree, "tags")
  let tag = run makeTextBox(&mut tree, "tag", "streaming")
  run tree.append(tags, tag)
  run tree.append(head, av)
  run tree.append(head, meta)
  run tree.append(head, tags)
  run tree.append(card, head)

  let p = run makeBox(&mut tree, "p")
  let t = run tree.text("")
  run tree.append(p, t)
  run tree.append(card, p)

  let foot = run makeBox(&mut tree, "foot")
  let a1 = run makeTextBox(&mut tree, "act", "Copy")
  let a2 = run makeTextBox(&mut tree, "act", "Retry")
  let a3 = run makeTextBox(&mut tree, "act", "Cite")
  run tree.append(foot, a1)
  run tree.append(foot, a2)
  run tree.append(foot, a3)
  run tree.append(card, foot)

  run tree.append(scroller, card)
  return StreamCard { card: card, foot: foot, textNode: t }
}

fn nsToMs(ns: u64) -> f64 {
  return u64.toF64(ns) / 1000000.0
}

effect fn runBench(profPtr: *mut ProfState) -> () ! TreeError | ProtocolError | OutOfMemoryError ? &mut Allocator {
  let tStart = run nowNs()

  let corpus = run MessageSlices.parse()
  let tCorpus = run nowNs()

  let fonts = FontCollection.make()
  let mut tree = run Tree.make(&fonts)

  // Load the 4 bundled TTF fonts
  let tFonts0 = run nowNs()
  drop run tree.addFont(Source.read("assets/fonts/Inter-Regular.ttf"))
  drop run tree.addFont(Source.read("assets/fonts/Inter-Bold.ttf"))
  drop run tree.addFont(Source.read("assets/fonts/Inter-Italic.ttf"))
  drop run tree.addFont(Source.read("assets/fonts/JetBrainsMono-Regular.ttf"))
  let tFonts1 = run nowNs()

  // Decode the 4 bundled PNG images
  let tImgs0 = run nowNs()
  let pics: [Resource; 4] = [
    run tree.defineImage(Source.read("assets/images/picture-0.png")),
    run tree.defineImage(Source.read("assets/images/picture-1.png")),
    run tree.defineImage(Source.read("assets/images/picture-2.png")),
    run tree.defineImage(Source.read("assets/images/picture-3.png")),
  ]
  let tImgs1 = run nowNs()

  // Compile shared CSS stylesheet synchronously
  let tCss0 = run nowNs()
  let compiledSheet = style_runtime.runtime().call(Source.read("data/chat.css"))
  let tCss1 = run nowNs()

  // Build 500 messages directly via raw ui-tree
  let mut tok0 = ()
  let ps0 = unsafe Pointer.borrowMut(&mut tok0, profPtr)
  ps0.reset()
  let tBuild0 = run nowNs()
  let root = run makeBox(&mut tree, "root")
  let scroller = run makeBox(&mut tree, "scroller")
  run tree.append(root, scroller)
  run tree.setRoot(root)
  if let Option.Some { value: sheetBytes } = move compiledSheet {
    let mut batch = List<Mutation>.make()
    run batch.append(Mutation.AdoptStyleSheet { root: FIRST_ROOT, sheet: 1, bytes: move sheetBytes })
    run tree.apply(move batch)
  }
  let mut i: usize = 0
  while i < INITIAL_MESSAGES {
    run appendMessage(&mut tree, scroller, &corpus, i, &pics)
    i = i + 1
  }
  let tBuild1 = run nowNs()

  // Initial Frame (Style + Text Shaping + Layout + Paint + Glyph Uploads)
  let mut tok1 = ()
  let ps1 = unsafe Pointer.borrowMut(&mut tok1, profPtr)
  ps1.reset()
  let tFrame0 = run nowNs()
  let vp = Viewport { width: WIDTH, height: HEIGHT, scale: SCALE }
  let _f0 = run tree.frame(vp, 0.0)
  drop _f0
  tree.clearUploads()
  let tFrame1 = run nowNs()

  let mut tok2 = ()
  let ps = unsafe Pointer.borrowMut(&mut tok2, profPtr)
  let initStyleNs = ps.ns[B_STYLE]
  let initShapeNs = ps.ns[B_ANALYZE] + ps.ns[B_SHAPE]
  let initShapeCalls = ps.calls[B_SHAPE]
  let initLayoutTotalNs = ps.ns[B_LAYOUT]
  let initLayoutPureNs = if initLayoutTotalNs > initShapeNs { initLayoutTotalNs - initShapeNs } else { 0 }
  let initPaintRootsNs = ps.ns[B_PAINT_ROOTS]
  let initSceneFinishNs = ps.ns[B_SCENE_FINISH]
  let initUploadsNs = ps.ns[B_UPLOADS]
  let initPaintTotalNs = ps.ns[B_PAINT]
  let initPaintPrepNs = if initPaintTotalNs > initUploadsNs { initPaintTotalNs - initUploadsNs } else { initPaintRootsNs + initSceneFinishNs }
  let nodeCount = tree.nodeCount()

  // Phase 2: 30 Scroll Frames (480px per frame = 14,400px sweep)
  ps.reset()
  let mut scrollMutNs: u64 = 0
  let mut scrollFrameNs: u64 = 0
  let mut sf: usize = 0
  while sf < SCROLL_FRAMES {
    let sm0 = run nowNs()
    run tree.scrollTo(scroller, 0.0, usize.toF32((sf + 1) * 480))
    let sm1 = run nowNs()
    let f = run tree.frame(vp, usize.toF64(sf + 1) * (1.0 / 60.0))
    drop f
    tree.clearUploads()
    let sm2 = run nowNs()
    scrollMutNs = scrollMutNs + (sm1 - sm0)
    scrollFrameNs = scrollFrameNs + (sm2 - sm1)
    sf = sf + 1
  }
  let scrollStyleNs = ps.ns[B_STYLE]
  let scrollShapeNs = ps.ns[B_ANALYZE] + ps.ns[B_SHAPE]
  let scrollLayoutTotalNs = ps.ns[B_LAYOUT]
  let scrollLayoutPureNs = if scrollLayoutTotalNs > scrollShapeNs { scrollLayoutTotalNs - scrollShapeNs } else { 0 }
  let scrollUploadsNs = ps.ns[B_UPLOADS]
  let scrollPaintTotalNs = ps.ns[B_PAINT]
  let scrollPaintPrepNs = if scrollPaintTotalNs > scrollUploadsNs { scrollPaintTotalNs - scrollUploadsNs } else { ps.ns[B_PAINT_ROOTS] + ps.ns[B_SCENE_FINISH] }

  // Prepare Phase 3: scroll to bottom + create streaming assistant message
  run tree.scrollTo(scroller, 0.0, 10000000.0)
  let sc0 = run makeStreamCard(&mut tree, scroller)
  let mut streamCard = sc0.card
  let mut streamFoot = sc0.foot
  let mut streamTextNode = sc0.textNode
  let _fPrep = run tree.frame(vp, 1.0)
  drop _fPrep
  tree.clearUploads()

  let streamWords: [string; 24] = [
    "incremental", "layout", "shaping", "glyph", "pipeline", "compositor",
    "frame", "budget", "viewport", "scroller", "harfbuzz", "rasterizer",
    "surface", "texture", "quad", "atlas", "baseline", "kerning",
    "measured", "cached", "retained", "painted", "submitted", "aligned",
  ]

  ps.reset()
  let mut streamMutNs: u64 = 0
  let mut streamFrameNs: u64 = 0
  let mut streamBuf = String.make()
  let mut nextExtra: usize = INITIAL_MESSAGES
  let mut tf: usize = 0
  while tf < STREAM_FRAMES {
    let tm0 = run nowNs()
    let mut w: usize = 0
    while w < 6 {
      if streamBuf.ownedByteLength() > 0 { run streamBuf.append(" ") }
      run streamBuf.append(streamWords[(tf * 6 + w) % 24])
      w = w + 1
    }
    run tree.setText(streamTextNode, String.view(&streamBuf))

    if tf == 10 {
      let newP = run makeBox(&mut tree, "p")
      let newT = run tree.text("")
      run tree.append(newP, newT)
      run tree.insertBefore(streamCard, newP, streamFoot)
      streamTextNode = newT
      streamBuf.clear()
    }
    if tf == 15 {
      run appendMessage(&mut tree, scroller, &corpus, nextExtra, &pics)
      nextExtra = nextExtra + 1
      run appendMessage(&mut tree, scroller, &corpus, nextExtra, &pics)
      nextExtra = nextExtra + 1
      let sc2 = run makeStreamCard(&mut tree, scroller)
      streamCard = sc2.card
      streamFoot = sc2.foot
      streamTextNode = sc2.textNode
      streamBuf.clear()
    }
    if tf == 22 {
      let fig = run makeBox(&mut tree, "fig")
      let im = run tree.image(pics[1], &[])
      run tree.setAttribute(im, Attribute.ClassName { value: run String.copy("pic") })
      let cap = run makeTextBox(&mut tree, "cap", "Figure live: streamed chart during active response.")
      run tree.append(fig, im)
      run tree.append(fig, cap)
      run tree.insertBefore(streamCard, fig, streamFoot)
    }

    run tree.scrollTo(scroller, 0.0, 10000000.0)
    let tm1 = run nowNs()
    let f = run tree.frame(vp, 2.0 + usize.toF64(tf) * (1.0 / 60.0))
    drop f
    tree.clearUploads()
    let tm2 = run nowNs()
    streamMutNs = streamMutNs + (tm1 - tm0)
    streamFrameNs = streamFrameNs + (tm2 - tm1)
    tf = tf + 1
  }

  let streamStyleNs = ps.ns[B_STYLE]
  let streamShapeNs = ps.ns[B_ANALYZE] + ps.ns[B_SHAPE]
  let streamLayoutTotalNs = ps.ns[B_LAYOUT]
  let streamLayoutPureNs = if streamLayoutTotalNs > streamShapeNs { streamLayoutTotalNs - streamShapeNs } else { 0 }
  let streamUploadsNs = ps.ns[B_UPLOADS]
  let streamPaintTotalNs = ps.ns[B_PAINT]
  let streamPaintPrepNs = if streamPaintTotalNs > streamUploadsNs { streamPaintTotalNs - streamUploadsNs } else { ps.ns[B_PAINT_ROOTS] + ps.ns[B_SCENE_FINISH] }

  // Emit JSON result
  let sfN = usize.toF64(SCROLL_FRAMES)
  let stN = usize.toF64(STREAM_FRAMES)
  StderrWriter.print("{{\n", &())
  StderrWriter.print("  \"framework\": \"SilkUI (raw ui-tree)\",\n", &())
  StderrWriter.print("  \"messages\": {},\n", &.(INITIAL_MESSAGES))
  StderrWriter.print("  \"nodes\": {},\n", &.(nodeCount))
  StderrWriter.print("  \"initial\": {{\n", &())
  StderrWriter.print("    \"corpus_parse_ms\": {},\n", &.(nsToMs(tCorpus - tStart)))
  StderrWriter.print("    \"font_load_ms\": {},\n", &.(nsToMs(tFonts1 - tFonts0)))
  StderrWriter.print("    \"image_decode_ms\": {},\n", &.(nsToMs(tImgs1 - tImgs0)))
  StderrWriter.print("    \"css_parse_ms\": {},\n", &.(nsToMs(tCss1 - tCss0)))
  StderrWriter.print("    \"tree_build_ms\": {},\n", &.(nsToMs(tBuild1 - tBuild0)))
  StderrWriter.print("    \"style_ms\": {},\n", &.(nsToMs(initStyleNs)))
  StderrWriter.print("    \"text_shape_ms\": {},\n", &.(nsToMs(initShapeNs)))
  StderrWriter.print("    \"text_shape_calls\": {},\n", &.(initShapeCalls))
  StderrWriter.print("    \"layout_total_ms\": {},\n", &.(nsToMs(initLayoutTotalNs)))
  StderrWriter.print("    \"layout_pure_ms\": {},\n", &.(nsToMs(initLayoutPureNs)))
  StderrWriter.print("    \"paint_prep_ms\": {},\n", &.(nsToMs(initPaintPrepNs)))
  StderrWriter.print("    \"glyph_raster_ms\": {},\n", &.(nsToMs(initUploadsNs)))
  StderrWriter.print("    \"frame_total_ms\": {},\n", &.(nsToMs(tFrame1 - tFrame0)))
  StderrWriter.print("    \"cold_total_ms\": {}\n", &.(nsToMs(tFrame1 - tStart)))
  StderrWriter.print("  }},\n", &())
  StderrWriter.print("  \"scroll_per_frame\": {{\n", &())
  StderrWriter.print("    \"update_ms\": {},\n", &.(nsToMs(scrollMutNs) / sfN))
  StderrWriter.print("    \"style_ms\": {},\n", &.(nsToMs(scrollStyleNs) / sfN))
  StderrWriter.print("    \"text_shape_ms\": {},\n", &.(nsToMs(scrollShapeNs) / sfN))
  StderrWriter.print("    \"layout_pure_ms\": {},\n", &.(nsToMs(scrollLayoutPureNs) / sfN))
  StderrWriter.print("    \"paint_prep_ms\": {},\n", &.(nsToMs(scrollPaintPrepNs) / sfN))
  StderrWriter.print("    \"glyph_raster_ms\": {},\n", &.(nsToMs(scrollUploadsNs) / sfN))
  StderrWriter.print("    \"frame_total_ms\": {}\n", &.(nsToMs(scrollMutNs + scrollFrameNs) / sfN))
  StderrWriter.print("  }},\n", &())
  StderrWriter.print("  \"stream_per_frame\": {{\n", &())
  StderrWriter.print("    \"update_ms\": {},\n", &.(nsToMs(streamMutNs) / stN))
  StderrWriter.print("    \"style_ms\": {},\n", &.(nsToMs(streamStyleNs) / stN))
  StderrWriter.print("    \"text_shape_ms\": {},\n", &.(nsToMs(streamShapeNs) / stN))
  StderrWriter.print("    \"layout_pure_ms\": {},\n", &.(nsToMs(streamLayoutPureNs) / stN))
  StderrWriter.print("    \"paint_prep_ms\": {},\n", &.(nsToMs(streamPaintPrepNs) / stN))
  StderrWriter.print("    \"glyph_raster_ms\": {},\n", &.(nsToMs(streamUploadsNs) / stN))
  StderrWriter.print("    \"frame_total_ms\": {}\n", &.(nsToMs(streamMutNs + streamFrameNs) / stN))
  StderrWriter.print("  }}\n", &())
  StderrWriter.print("}}\n", &())
}

effect fn runWithTracer(profPtr: *mut ProfState) -> () ! TreeError | ProtocolError | OutOfMemoryError ? &mut Allocator {
  let tracer = run Arc<BenchTracer>.make(BenchTracer { state: profPtr })
  run runBench(profPtr) |> Effect.provideAmbient<Tracer>(&tracer)
}

pub effect fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  let mut profState = ProfState.make()
  let profPtr = Pointer.fromMutRef(&mut profState)
  let res = run Effect.result(
    runWithTracer(profPtr) |> Effect.provideMut<Allocator>(&mut alloc),
  )
  if let Result.Failure { error } = move res {
    drop error
    StderrWriter.print("silk chat-bench failed\n", &())
    return 1
  }
  return 0
}
