diff -ruN a/bench_prof.rs b/bench_prof.rs
--- a/bench_prof.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/bench_prof.rs	2026-11-27 21:02:14.166154558 +0000
@@ -0,0 +1,162 @@
+//! Lightweight atomic phase profiler inside ferroui-base for chat-bench.
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+pub static STYLE_NS: AtomicU64 = AtomicU64::new(0);
+pub static LAYOUT_TOTAL_NS: AtomicU64 = AtomicU64::new(0);
+pub static STYLE_IN_LAYOUT_NS: AtomicU64 = AtomicU64::new(0);
+pub static TEXT_SHAPE_NS: AtomicU64 = AtomicU64::new(0);
+pub static TEXT_SHAPE_IN_LAYOUT_NS: AtomicU64 = AtomicU64::new(0);
+pub static TEXT_SHAPE_IN_PAINT_NS: AtomicU64 = AtomicU64::new(0);
+pub static TEXT_SHAPE_CALLS: AtomicU64 = AtomicU64::new(0);
+pub static PAINT_PREP_NS: AtomicU64 = AtomicU64::new(0);
+pub static RASTER_NS: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    static IN_LAYOUT: Cell<u32> = const { Cell::new(0) };
+    static IN_STYLE: Cell<u32> = const { Cell::new(0) };
+    static IN_TEXT: Cell<u32> = const { Cell::new(0) };
+    static IN_PAINT: Cell<u32> = const { Cell::new(0) };
+    static IN_RASTER: Cell<u32> = const { Cell::new(0) };
+}
+
+#[derive(Default, Debug, Clone, Copy)]
+pub struct Snapshot {
+    pub style_ns: u64,
+    pub style_in_layout_ns: u64,
+    pub layout_total_ns: u64,
+    pub text_shape_ns: u64,
+    pub text_shape_in_layout_ns: u64,
+    pub text_shape_in_paint_ns: u64,
+    pub text_shape_calls: u64,
+    pub paint_prep_ns: u64,
+    pub raster_ns: u64,
+}
+
+pub fn reset() {
+    STYLE_NS.store(0, Relaxed);
+    STYLE_IN_LAYOUT_NS.store(0, Relaxed);
+    LAYOUT_TOTAL_NS.store(0, Relaxed);
+    TEXT_SHAPE_NS.store(0, Relaxed);
+    TEXT_SHAPE_IN_LAYOUT_NS.store(0, Relaxed);
+    TEXT_SHAPE_IN_PAINT_NS.store(0, Relaxed);
+    TEXT_SHAPE_CALLS.store(0, Relaxed);
+    PAINT_PREP_NS.store(0, Relaxed);
+    RASTER_NS.store(0, Relaxed);
+}
+
+pub fn snapshot() -> Snapshot {
+    Snapshot {
+        style_ns: STYLE_NS.load(Relaxed),
+        style_in_layout_ns: STYLE_IN_LAYOUT_NS.load(Relaxed),
+        layout_total_ns: LAYOUT_TOTAL_NS.load(Relaxed),
+        text_shape_ns: TEXT_SHAPE_NS.load(Relaxed),
+        text_shape_in_layout_ns: TEXT_SHAPE_IN_LAYOUT_NS.load(Relaxed),
+        text_shape_in_paint_ns: TEXT_SHAPE_IN_PAINT_NS.load(Relaxed),
+        text_shape_calls: TEXT_SHAPE_CALLS.load(Relaxed),
+        paint_prep_ns: PAINT_PREP_NS.load(Relaxed),
+        raster_ns: RASTER_NS.load(Relaxed),
+    }
+}
+
+pub struct StyleScope(Option<Instant>);
+impl StyleScope {
+    #[inline]
+    pub fn enter() -> Self {
+        let d = IN_STYLE.with(|c| { let v = c.get(); c.set(v + 1); v });
+        Self(if d == 0 { Some(Instant::now()) } else { None })
+    }
+}
+impl Drop for StyleScope {
+    #[inline]
+    fn drop(&mut self) {
+        IN_STYLE.with(|c| c.set(c.get().saturating_sub(1)));
+        if let Some(t0) = self.0 {
+            let dt = t0.elapsed().as_nanos() as u64;
+            STYLE_NS.fetch_add(dt, Relaxed);
+            if IN_LAYOUT.with(|c| c.get() > 0) {
+                STYLE_IN_LAYOUT_NS.fetch_add(dt, Relaxed);
+            }
+        }
+    }
+}
+
+pub struct LayoutScope(Option<Instant>);
+impl LayoutScope {
+    #[inline]
+    pub fn enter() -> Self {
+        let d = IN_LAYOUT.with(|c| { let v = c.get(); c.set(v + 1); v });
+        Self(if d == 0 { Some(Instant::now()) } else { None })
+    }
+}
+impl Drop for LayoutScope {
+    #[inline]
+    fn drop(&mut self) {
+        IN_LAYOUT.with(|c| c.set(c.get().saturating_sub(1)));
+        if let Some(t0) = self.0 {
+            LAYOUT_TOTAL_NS.fetch_add(t0.elapsed().as_nanos() as u64, Relaxed);
+        }
+    }
+}
+
+pub struct TextScope(Option<Instant>);
+impl TextScope {
+    #[inline]
+    pub fn enter() -> Self {
+        TEXT_SHAPE_CALLS.fetch_add(1, Relaxed);
+        let d = IN_TEXT.with(|c| { let v = c.get(); c.set(v + 1); v });
+        Self(if d == 0 { Some(Instant::now()) } else { None })
+    }
+}
+impl Drop for TextScope {
+    #[inline]
+    fn drop(&mut self) {
+        IN_TEXT.with(|c| c.set(c.get().saturating_sub(1)));
+        if let Some(t0) = self.0 {
+            let dt = t0.elapsed().as_nanos() as u64;
+            TEXT_SHAPE_NS.fetch_add(dt, Relaxed);
+            if IN_LAYOUT.with(|c| c.get() > 0) {
+                TEXT_SHAPE_IN_LAYOUT_NS.fetch_add(dt, Relaxed);
+            } else if IN_PAINT.with(|c| c.get() > 0) {
+                TEXT_SHAPE_IN_PAINT_NS.fetch_add(dt, Relaxed);
+            }
+        }
+    }
+}
+
+pub struct PaintScope(Option<Instant>);
+impl PaintScope {
+    #[inline]
+    pub fn enter() -> Self {
+        let d = IN_PAINT.with(|c| { let v = c.get(); c.set(v + 1); v });
+        Self(if d == 0 { Some(Instant::now()) } else { None })
+    }
+}
+impl Drop for PaintScope {
+    #[inline]
+    fn drop(&mut self) {
+        IN_PAINT.with(|c| c.set(c.get().saturating_sub(1)));
+        if let Some(t0) = self.0 {
+            PAINT_PREP_NS.fetch_add(t0.elapsed().as_nanos() as u64, Relaxed);
+        }
+    }
+}
+
+pub struct RasterScope(Option<Instant>);
+impl RasterScope {
+    #[inline]
+    pub fn enter() -> Self {
+        let d = IN_RASTER.with(|c| { let v = c.get(); c.set(v + 1); v });
+        Self(if d == 0 { Some(Instant::now()) } else { None })
+    }
+}
+impl Drop for RasterScope {
+    #[inline]
+    fn drop(&mut self) {
+        IN_RASTER.with(|c| c.set(c.get().saturating_sub(1)));
+        if let Some(t0) = self.0 {
+            RASTER_NS.fetch_add(t0.elapsed().as_nanos() as u64, Relaxed);
+        }
+    }
+}
