+/// GPU timings of the last frame of the first window, for a thread started with
+/// [`RenderThread.prepareTimed`]: such a thread waits for the GPU to finish each frame before
+/// it reports it, so a caller that waits for the frame waits for the GPU too.
+pub struct GpuTimes {
+  /// Milliseconds from the return of the present call to the GPU finishing the frame's work.
+  pub wait: f64,
+  /// Milliseconds the GPU spent on the frame's commands (timestamp queries around the frame's
+  /// passes), -1 when the device has no timestamp queries.
+  pub exec: f64,
+  /// Milliseconds spent reading the timestamps back, after the GPU finished.
+  pub readback: f64,
+  /// Milliseconds from taking the frame to acquiring the drawable: atlas pixel writes and
+  /// adopting the frame.
+  pub prepare: f64,
+  /// When the GPU finished the frame, in seconds of the monotonic clock (`clock.Clock`).
+  pub completedAt: f64,
+}
+
+impl Copy for GpuTimes {}
+
+impl GpuTimes {
+  fn none() -> GpuTimes {
+    return GpuTimes { wait: 0.0, exec: -1.0, readback: 0.0, prepare: 0.0, completedAt: 0.0 }
+  }
+}
+
+/// The timestamp queries of a timed render thread: two empty render passes on a 1x1 texture,
+/// before and after the frame's passes, write the GPU's clock at their start and end (Metal
+/// takes no samples in an empty compute pass).
+struct Stamps {
+  set: QuerySet,
+  resolved: Buffer,
+  read: Buffer,
+  target: Texture,
+  view: TextureView,
+}
+
+const STAMP_BYTES: u64 = 32
+
+effect fn makeStamps(device: &Device) -> Stamps
+  ! GpuError {
+  let mut sets = QuerySetDescriptor.default().withLabel(b"frame stamps")
+  sets.setType(flags.WGPUQueryType_Timestamp)
+  sets.setCount(4)
+  let set = run createQuerySet(device, &sets)
+  let mut resolving = BufferDescriptor.default().withLabel(b"frame stamps resolved")
+  resolving.setUsage(flags.WGPUBufferUsage_QueryResolve | flags.WGPUBufferUsage_CopySrc)
+  resolving.setSize(STAMP_BYTES)
+  let resolved = run createBuffer(device, &resolving)
+  let mut reading = BufferDescriptor.default().withLabel(b"frame stamps read")
+  reading.setUsage(flags.WGPUBufferUsage_MapRead | flags.WGPUBufferUsage_CopyDst)
+  reading.setSize(STAMP_BYTES)
+  let read = run createBuffer(device, &reading)
+  let mut size = Extent3D.default()
+  size.setWidth(1)
+  size.setHeight(1)
+  size.setDepthOrArrayLayers(1)
+  let mut texturing = TextureDescriptor.default().withLabel(b"frame stamps target")
+  texturing.setSize(size)
+  texturing.setFormat(flags.WGPUTextureFormat_RGBA8Unorm)
+  texturing.setDimension(flags.WGPUTextureDimension_2D)
+  texturing.setMipLevelCount(1)
+  texturing.setSampleCount(1)
+  texturing.setUsage(flags.WGPUTextureUsage_RenderAttachment)
+  let target = run createTexture(device, &texturing)
+  let view = run target.createView(&TextureViewDescriptor.default())
+  return Stamps { set: move set, resolved: move resolved, read: move read, target: move target, view: move view }
+}
+
+effect fn stamp(encoder: &mut CommandEncoder, stamps: &Stamps, first: u32) -> ()
+  ! GpuError {
+  let mut writes = PassTimestampWrites.default().withQuerySet(&stamps.set)
+  writes.setBeginningOfPassWriteIndex(first)
+  writes.setEndOfPassWriteIndex(first + 1)
+  let mut color = RenderPassColorAttachment.default().withView(&stamps.view)
+  color.setLoadOp(flags.WGPULoadOp_Clear)
+  color.setStoreOp(flags.WGPUStoreOp_Discard)
+  let colors = [color]
+  let descriptor = RenderPassDescriptor.default().withLabel(b"frame stamp").withColorAttachments(&colors).withTimestampWrites(&writes)
+  let pass = run encoder.beginRenderPass(&descriptor)
+  pass.end()
+}
+
+fn stampAt(bytes: &[u8], index: usize) -> u64 {
+  let mut value: u64 = 0
+  let mut i: usize = 0
+  while i < 8 {
+    value = value | u64.shiftLeft(u8.toU64(bytes[index * 8 + i]), usize.toU64(i * 8))
+    i = i + 1
+  }
+  return value
+}
+
+fn recordGpu(shared: &Arc<Mutex<State>>, times: GpuTimes) -> () {
+  let mut guard = shared.get().lock()
+  let values = guard.getMut()
+  values.gpu = times
+}
